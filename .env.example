# 複製這個檔案並改名成 .env，填好後重新執行 start.bat
# 語音金鑰也可以直接在網頁的「聲音設定」頁貼上，會自動存進 .env
# .env 裡有金鑰，不要傳給別人
# 雲端版（Vercel）不讀這個檔案：同樣的名稱改填在 Vercel → Settings → Environment Variables，改完要 Redeploy

# ---- AI 大腦（文字）：ollama（本機）/ chatgpt（ChatGPT 訂閱）/ gemini / azure / openai
# 雲端版沒填時是 gemini；選 chatgpt 要先在網頁「AI 大腦」登入
LLM_PROVIDER=ollama
OLLAMA_MODEL=qwen3.5:9b
# 雲端版要用 Ollama，得填一台雲端連得到的 Ollama 網址
OLLAMA_BASE_URL=

# 主要大腦不能用時依序改用（只有 chatgpt、gemini 當主要大腦時才有備援；雲端不會用 Ollama）
BRAIN_BACKUPS=gemini,ollama

# 即時通話（Gemini Live）：1 開、0 關。沒填時跟以前一樣：大腦選 gemini 才開
LIVE_ENABLED=

AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-4.1-mini

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# 即時教練另外用比較快的模型；留空就用主要模型
AZURE_OPENAI_COACH_DEPLOYMENT=
OPENAI_COACH_MODEL=

# ---- 客戶的聲音：elevenlabs / gemini / yating / browser（不填就自動選有金鑰的）
TTS_PROVIDER=
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL=eleven_v3_conversational
GEMINI_API_KEY=
GEMINI_TTS_MODEL=gemini-3.8-flash-lite-tts
# 即時對話時，最後評分用的文字模型
GEMINI_MODEL=gemini-3.8-flash
# 即時教練用的快速模型（每句都要跑，要快）
GEMINI_COACH_MODEL=gemini-3.1-flash-lite
GEMINI_COACH_REASONING=minimal
YATING_API_KEY=

# ---- 填 1：考核期間不能修改「我的背景」
PROFILE_LOCKED=

# ---- ChatGPT 訂閱（用自己的 Plus／Pro 方案額度，只限本人使用，不可共用帳號）
# 本機版：網頁「AI 大腦」→ Continue with ChatGPT 登入，登入資料存在 .chatgpt/（不要傳給別人）
# 雲端版：在 Vercel 設 CHATGPT_SYNC_KEY，再到本機版「AI 大腦 → 雲端版」貼上雲端網址和同一組同步密碼，
#         按「登入並同步到雲端」；之後由雲端自己續期
# 下面兩個由網頁「雲端版」設定自動寫入
CLOUD_URL=
CHATGPT_SYNC_KEY=
# 指定模型；留空就用帳號清單的第一個（也可以在網頁上選）
CHATGPT_MODEL=
CHATGPT_COACH_MODEL=
# 以下通常不用改（OpenAI 改網址或參數時才需要）
# CHATGPT_MODE=auto                 # auto / local / synced / hosted / off
# CHATGPT_AGENT_NAME=AI 理專對練教練
# CHATGPT_HOST_ID=                  # 不填會自動產生，存在 .chatgpt/
# CHATGPT_SCOPES=openid profile email offline_access resource.invoke chatgpt.tokens.use.direct
# CHATGPT_RESOURCE=https://api.openai.com/v1
# CHATGPT_API_BASE=https://api.openai.com/v1
# CHATGPT_DISCOVERY_URL=https://auth.openai.com/.well-known/openid-configuration
# CHATGPT_AUTHORIZE_URL=https://auth.openai.com/api/accounts/authorize
# CHATGPT_TOKEN_URL=https://auth.openai.com/api/accounts/oauth/token
# CHATGPT_REVOKE_URL=https://auth.openai.com/api/accounts/oauth/revoke
# CHATGPT_JWKS_URL=https://auth.openai.com/.well-known/jwks.json
# CHATGPT_ISSUER=https://auth.openai.com
# CHATGPT_REDIRECT_PATH=/auth/callback
# CHATGPT_JSON_MODE=schema          # schema：要求固定 JSON 格式；none：不要求
# CHATGPT_REASONING_EFFORT=         # 留空不指定
# CHATGPT_COACH_REASONING_EFFORT=low
# CHATGPT_VERIFY_ID_TOKEN=1
# CHATGPT_COOLDOWN_SEC=900          # 用量到上限後，多久不再試 ChatGPT（秒）
# CHATGPT_TIMEOUT=60
# CHATGPT_CHAT_MAX_CHARS=300        # 客戶一次最多講多長（字）
# OpenAI 核准網站登入後才用得到（目前不用填）
# CHATGPT_CLIENT_ID=
# CHATGPT_CLIENT_SECRET=
# CHATGPT_TOKEN_AUTH=               # none / client_secret_basic / client_secret_post
# CHATGPT_REDIRECT_URI=https://你的網域/auth/callback

# ---- 以下只在雲端版（Vercel 環境變數）設定，本機不用填
# APP_MODE=cloud
# APP_PASSCODE=                     # 進網站的通行碼
# ADMIN_PASSCODE=                   # 管理者通行碼（改設定、改情境）；不填就是登入的人都能改
# APP_SECRET=                       # 40 個以上的亂碼：簽登入 cookie、加密 ChatGPT 登入資料
# AUTH_MODE=passcode                # vercel：改用 Vercel 的 Deployment Protection，不用通行碼
# ALLOWED_HOSTS=                    # 自己的網域（逗號分隔）
# PROFILE_SCOPE=user                # user：每個瀏覽器各自的背景；shared：大家共用
# SESSION_DAYS=180
# 資料庫：Vercel → Storage → Upstash 連好後會自動加上這兩個
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
# STORE_PREFIX=aicoach:
# STORE_CACHE_TTL=10
# TTS_CACHE_TTL_DAYS=30
