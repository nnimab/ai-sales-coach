# 複製這個檔案並改名成 .env，填好後重新執行 start.bat
# 語音金鑰也可以直接在網頁的「聲音設定」頁貼上，會自動存進 .env
# .env 裡有金鑰，不要傳給別人

# ---- AI 大腦：ollama（本機）/ azure / openai / gemini（Gemini 3.8 Live 即時對話，用下面的 GEMINI_API_KEY）
LLM_PROVIDER=ollama
OLLAMA_MODEL=qwen3.5:9b

AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-4.1-mini

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# 即時教練另外用比較快的模型；留空就用主要模型
AZURE_OPENAI_COACH_DEPLOYMENT=
OPENAI_COACH_MODEL=

# ---- 客戶的聲音：elevenlabs / gemini / yating / browser（不填就自動選有金鑰的）
TTS_PROVIDER=
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL=eleven_v3_conversational
GEMINI_API_KEY=
GEMINI_TTS_MODEL=gemini-3.8-flash-lite-tts
# 即時對話時，最後評分用的文字模型
GEMINI_MODEL=gemini-3.8-flash
# 即時教練用的快速模型（每句都要跑，要快）
GEMINI_COACH_MODEL=gemini-3.1-flash-lite
GEMINI_COACH_REASONING=minimal
YATING_API_KEY=

# ---- 填 1：考核期間不能修改「我的背景」
PROFILE_LOCKED=
